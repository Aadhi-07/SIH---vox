# VoxGuard Frontend Environment Variables
# In production (e.g. Vercel dashboard), set VITE_API_URL to your deployed Render backend:
# Either scheme works (the client automatically derives both wss:// for WebSockets and https:// for REST):
VITE_API_URL=wss://sih-vox.onrender.com

# In local development, you can omit this or use:
# VITE_API_URL=ws://localhost:8000
